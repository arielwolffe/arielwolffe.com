---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { profile, now, projects, writing, talksNote } from "../content/site";

const featured = projects.slice(0, 2);
const rest = projects.slice(2);
---

<Base>
  <Header />
  <main id="main">
    <!-- Hero -->
    <section class="hero">
      <div class="confetti" aria-hidden="true">
        <span class="dot-a"></span><span class="dot-b"></span><span class="dot-c"></span><span class="dot-d"></span>
      </div>
      <div class="wrap">
        <p class="kicker">{profile.nameLine}</p>
        <h1>Ariel <em class="twist">Wolffe</em></h1>
        <p class="lede">{profile.intro}</p>
        <div class="hero-links">
          <a class="button" href="#projects">See the projects</a>
          <a class="button ghost" href="#writing">Read the writing</a>
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="band cream">
      <div class="wrap">
        <p class="kicker">Projects</p>
        <h2>Side quests, <em class="twist">shipped.</em></h2>

        <div class="featured">
          {
            featured.map((p, i) => (
              <article class={`feature v${i}`}>
                <p class={`status ${p.status === "Live" ? "live" : ""}`}>{p.status}</p>
                <h3>{p.name}</h3>
                <p class="one">{p.oneLiner}</p>
                <p>{p.summary}</p>
                <ul class="tags" aria-label="Tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
                <div class="actions">
                  {p.caseStudy && (
                    <a class="button" href={`/projects/${p.slug}`}>
                      Read the case study<span class="visually-hidden">: {p.name}</span> →
                    </a>
                  )}
                  {p.links?.map((l) => (
                    <a class="text-link" href={l.href} target="_blank" rel="noopener">
                      {l.label} ↗
                    </a>
                  ))}
                </div>
              </article>
            ))
          }
        </div>

        <div class="cards">
          {
            rest.map((p, i) => (
              <article class={`card v${(i + 2) % 4}`}>
                <p class="status">{p.status}</p>
                <h3>{p.name}</h3>
                <p>{p.summary}</p>
                <ul class="tags" aria-label="Tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Now -->
    <section id="now" class="band">
      <div class="wrap now-grid">
        <div>
          <p class="kicker">Now</p>
          <h2>What I'm <em class="twist">up to.</em></h2>
        </div>
        <ul class="now-list">
          {now.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </section>

    <!-- Writing -->
    <section id="writing" class="band sorrel">
      <div class="petal" aria-hidden="true"></div>
      <div class="wrap narrow">
        <p class="kicker">Writing</p>
        <h2>The stories <em class="twist">behind the builds.</em></h2>
        <p class="lede">{writing.pitch}</p>
        {
          writing.url ? (
            <a class="button gold" href={writing.url} target="_blank" rel="noopener">
              Subscribe on Substack →
            </a>
          ) : (
            <p class="soon">
              <span class="orb" aria-hidden="true" /> First issue coming soon.
            </p>
          )
        }
      </div>
    </section>

    <!-- About -->
    <section id="about" class="band">
      <div class="wrap narrow">
        <p class="kicker">About</p>
        <h2>A bit about <em class="twist">me.</em></h2>
        {profile.about.map((p) => <p class="about-p">{p}</p>)}
        <div class="day-job">
          <p class="dj-title">{profile.dayJob.title}</p>
          <p>{profile.dayJob.line}</p>
          <a class="text-link" href={profile.dayJob.link.href} target="_blank" rel="noopener">
            {profile.dayJob.link.label} ↗
          </a>
        </div>
        <p class="talks-note">{talksNote}</p>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="band sorrel">
      <div class="orb big" aria-hidden="true"></div>
      <div class="wrap narrow">
        <p class="kicker">Contact</p>
        <h2>Say <em class="twist">hello.</em></h2>
        <p>The best way to reach me is on LinkedIn.</p>
        <div class="hero-links">
          {
            profile.links.map((l) => (
              <a class="button gold" href={l.href} rel="me noopener" target="_blank">
                {l.label} →
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(120px, 20vh, 220px) 0 clamp(72px, 12vh, 140px);
  }
  .hero h1 {
    font-size: clamp(64px, 13vw, 168px);
    line-height: 0.9;
  }
  .hero .lede {
    margin-top: 26px;
  }
  .hero-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }
  .confetti span {
    position: absolute;
    border-radius: 50%;
    animation: drift 9s ease-in-out infinite;
  }
  .dot-a {
    width: clamp(160px, 26vw, 360px);
    aspect-ratio: 1;
    right: -6vw;
    top: -4vw;
    background: var(--hibiscus);
  }
  .dot-b {
    width: clamp(60px, 8vw, 110px);
    aspect-ratio: 1;
    right: 14vw;
    bottom: 14%;
    background: var(--gold-orb);
    animation-duration: 7s !important;
  }
  .dot-c {
    width: clamp(22px, 3vw, 40px);
    aspect-ratio: 1;
    right: 26vw;
    bottom: 34%;
    background: var(--sea);
    animation-duration: 6s !important;
  }
  .dot-d {
    width: clamp(90px, 14vw, 200px);
    aspect-ratio: 1;
    right: 42vw;
    top: -60px;
    background: var(--sorrel);
    animation-duration: 12s !important;
  }

  /* Projects */
  .featured {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }
  .feature,
  .card {
    background: var(--ivory);
    border-radius: 20px;
    padding: 32px;
    position: relative;
    overflow: hidden;
    transition: transform 0.3s var(--ease-out), box-shadow 0.3s;
  }
  .feature:hover,
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px color-mix(in srgb, var(--wine) 12%, transparent);
  }
  .feature::after,
  .card::after {
    content: "";
    position: absolute;
    border-radius: 50%;
  }
  .feature::after {
    width: 120px;
    height: 120px;
    right: -34px;
    top: -34px;
  }
  .card::after {
    width: 70px;
    height: 70px;
    right: -18px;
    top: -18px;
  }
  .v0::after {
    background: var(--hibiscus);
  }
  .v1::after {
    background: var(--gold-orb);
  }
  .v2::after {
    background: var(--sea);
  }
  .v3::after {
    background: var(--sorrel);
  }
  .feature h3 {
    font-size: clamp(32px, 3.6vw, 44px);
    margin: 8px 0;
    max-width: 85%;
  }
  .feature .one {
    font-family: var(--font-italic);
    font-style: italic;
    font-size: 20px;
    color: var(--sorrel);
    margin: 0 0 10px;
  }
  .feature p,
  .card p {
    margin: 0 0 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px;
    margin-top: 22px;
  }
  .text-link {
    font-weight: 700;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .card h3 {
    font-size: 26px;
    margin: 6px 0 10px;
  }

  /* Now */
  .now-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: start;
  }
  .now-list {
    list-style: none;
    padding: 0;
    margin: 6px 0 0;
  }
  .now-list li {
    font-size: 19px;
    padding: 16px 0 16px 34px;
    border-top: 1px solid color-mix(in srgb, var(--sorrel) 22%, transparent);
    position: relative;
  }
  .now-list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 26px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--hibiscus);
  }
  .now-list li:nth-child(2)::before {
    background: var(--gold-orb);
  }
  .now-list li:nth-child(3)::before {
    background: var(--sea);
  }
  .now-list li:nth-child(4)::before {
    background: var(--sorrel);
  }

  /* Writing */
  .petal {
    position: absolute;
    width: clamp(260px, 36vw, 520px);
    aspect-ratio: 1;
    right: -8vw;
    top: -10vw;
    border-radius: 50% 0 50% 0;
    background: var(--wine);
    opacity: 0.6;
    animation: turn 80s linear infinite;
  }
  .soon {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 700;
    margin-top: 24px;
  }
  .soon .orb {
    display: inline-block;
    width: 18px;
    height: 18px;
  }

  /* About */
  .about-p {
    font-size: 19px;
  }
  .day-job {
    margin-top: 36px;
    padding: 24px 28px;
    border-radius: 18px;
    background: var(--cream);
  }
  .day-job p {
    margin: 0 0 8px;
  }
  .dj-title {
    font-weight: 800;
    color: var(--sorrel);
  }
  .talks-note {
    margin-top: 24px;
    font-size: 15px;
    color: color-mix(in srgb, var(--wine) 75%, transparent);
  }

  /* Contact */
  .orb.big {
    position: absolute;
    width: clamp(160px, 22vw, 300px);
    aspect-ratio: 1;
    right: -50px;
    bottom: -70px;
    animation: drift 10s ease-in-out infinite;
  }

  @media (max-width: 900px) {
    .featured,
    .now-grid,
    .cards {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  @media (max-width: 720px) {
    .dot-b {
      right: 6vw;
      bottom: 6%;
    }
    .dot-c,
    .dot-d {
      display: none;
    }
    .feature,
    .card {
      padding: 26px;
    }
  }
</style>
