---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
---

<Base title="Lost · Ariel Wolffe">
  <Header showStoryToggle={false} />
  <main id="main" class="lost">
    <span class="orb" aria-hidden="true"></span>
    <p class="kicker">404</p>
    <h1>This page wandered <em class="twist">off.</em></h1>
    <p>Probably tinkering somewhere. Let's get you back.</p>
    <a class="button" href="/">Back home →</a>
  </main>
</Base>

<style>
  .lost {
    min-height: 80vh;
    padding: 18vh var(--gutter);
    position: relative;
    overflow: hidden;
  }
  .kicker {
    font-weight: 800;
    letter-spacing: 0.14em;
    color: var(--hibiscus-text);
  }
  h1 {
    font-size: clamp(48px, 9vw, 112px);
    max-width: 12ch;
  }
  .orb {
    position: absolute;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: var(--gold-orb);
    right: 8vw;
    top: 16vh;
  }
  .button {
    display: inline-block;
    margin-top: 12px;
    padding: 14px 26px;
    border-radius: 999px;
    background: var(--sorrel);
    color: var(--ivory);
    font-weight: 800;
    text-decoration: none;
  }
</style>
